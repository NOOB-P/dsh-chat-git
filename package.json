{
  "name": "dsh-chat-git",
  "version": "0.4.2",
  "private": true,
  "description": "DeepSeek Harness plugin: per-conversation git checkpoints — a repository check at conversation start (`git init` when there is none), an `Ai-coding：<description>` commit whenever a turn ends, and a one-click rollback that rewinds the conversation and the repository together.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/harness.mjs && node test/client.mjs",
    "test:host": "node test/harness.mjs",
    "test:client": "node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
